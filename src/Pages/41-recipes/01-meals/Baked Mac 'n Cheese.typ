#import "/prelude.typ": *

#Recipe(
  title: "Baked Mac 'n Cheese",
  yield: "2.5+ ℓ\n(potluck proportions)",
  refs: (
    <R_nacho-cheese>,
    <KABC_CHART>,
    <jlc_sodium-citrate-mac-cheese>,
    <mc_mac-and-cheese-recipe>,
    <mcc_mac-and-cheese-dijon-mustard>,
    <wls_smoky-mac-cheese>,
  ),
)[
  Pasta:
  - 6g salt@ss_pasta-salinity
  - 600g macaroni or shells, dry
  - 1200mℓ water #aside[5 cups]

  Sauce:
  - 675g milk #aside[3 cups]
  - 450g cheddar, shredded #aside[2 packets]
  - 225g monterey jack, shredded #aside[1 packet]
  - 40g Dijon mustard (1/4 cup)
  - 34g sodium citrate
  - 2.5g chili powder #aside[3/4 tsp.]
  - 1--2g liquid hickory smoke#Fn.liquid-hickory #aside[1/4--1/2 tsp.]
  - (optional) Yellow food dye

  Topping:
  + 75g @R_panko[panko] #aside[3/4 cup]
  + 42g butter #aside[3 tbsp.]
][
  + ASYNCHRONOUSLY:~
    - PREHEAT oven, 190°C. #aside[375°F]
    - MELT sauce, mixing over low-medium heat until combined. Do not boil.
    - BOIL pasta al dente. #aside[\~5-6 min.]
    - MIX topping thoroughly.
  + POUR sauce into tall baking tray, then pasta.
  + MIX thoroughly.
  + COAT dish with topping.
  + BAKE. #pause[20-25 min]
  + REST outside oven. #pause[5-7 min.]
]
